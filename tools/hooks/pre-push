#!/usr/bin/env bash
# 推送前凭证审计硬门（由 tools/install_hooks.sh 安装到 .git/hooks/pre-push）：
# 对每个待推本地引用扫描其已跟踪文件，任一剩余命中即拒绝整次推送。审计脚本/allowlist：tools/audit_secrets.py、tools/audit_allowlist.txt。
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # 删除远端引用：无内容可审
  if ! python3 tools/audit_secrets.py --ref "$local_sha"; then
    echo "pre-push: $local_ref -> $remote_ref 审计未过，拒绝推送" >&2; status=1
  fi
done
exit $status
